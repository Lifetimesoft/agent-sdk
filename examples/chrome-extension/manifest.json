{
  "manifest_version": 3,
  "name": "My AI Agent Extension",
  "version": "1.0.0",
  "description": "Chrome extension running a LifetimeSoft AI agent",
  "permissions": [
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://app.lifetimesoft.com/*",
    "https://generativelanguage.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "AI Agent"
  }
}
